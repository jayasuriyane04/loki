# Copy to backend/.env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector (docker compose up -d postgres). Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and every new connection stalls.
# SQLite (no Docker, no memory search in SQL): DATABASE_URL=sqlite+aiosqlite:///./loki.db
DATABASE_URL=postgresql+asyncpg://loki:loki@127.0.0.1:5432/loki

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Primary model — local via Ollama. LOKI runs its own Ollama on the NVIDIA GPU: scripts/start-ollama.ps1
# (qwen3:4b-instruct answers directly; thinking models like qwen3:4b reason first and are much slower)
LLM_PRIMARY_PROVIDER=ollama
LLM_PRIMARY_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11435
# auto = reasoning models think privately (hidden from replies). Thinking adds latency;
# for snappier voice replies use a non-thinking model.
OLLAMA_THINK=auto

# Voice — local speech recognition (faster-whisper) and synthesis (Kokoro)
VOICE_ENABLED=true
STT_MODEL=small
# cuda (NVIDIA GPU) or cpu; on CPU use STT_COMPUTE_TYPE=int8
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# blank = auto-detect language/accent; or e.g. en
STT_LANGUAGE=
TTS_PROVIDER=kokoro
# Kokoro model files: https://github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.0
TTS_MODEL_DIR=models/kokoro
TTS_VOICE=bm_george
TTS_SPEED=1.0

# Knowledge base (documents). Uploaded files are stored under UPLOAD_DIR (git-ignored).
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
# Reranker: https://huggingface.co/mixedbread-ai/mxbai-rerank-xsmall-v1 (onnx/model.onnx + tokenizer.json).
# Empty = no reranker (hybrid ranking only, less precise).
RERANK_MODEL_DIR=models/reranker/mxbai-rerank-xsmall-v1
RERANK_THRESHOLD=0.25

# Optional cloud fallback (used only if the primary fails before replying)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# e.g. LLM_FALLBACK_PROVIDER=gemini / LLM_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
